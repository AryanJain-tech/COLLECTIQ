# ============================================================
# CollectIQ – Environment Configuration
# ============================================================
# Copy this file to ".env" and fill it in. Never commit ".env".

# ---- Agent (required) -------------------------------------------------------
# Any long private phrase. It decides your agent's address, so keep it the same
# between runs and never share it.
AGENT_SEED=change-me-to-a-long-private-phrase
AGENT_PORT=8002

# ---- Business details -------------------------------------------------------
# Each chat user gets a private invoice database in this folder.
COLLECTIQ_DATA_DIR=data
BUSINESS_NAME=Your Business Name

# ---- Email (optional) -------------------------------------------------------
# Leave blank to stay in SANDBOX mode. All five values are needed for LIVE.
# For Gmail, use an App Password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- WhatsApp Business Cloud API (optional) ----------------------------------
# Leave blank to stay in SANDBOX mode. The first three values are needed for LIVE.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of your APPROVED template with 4 variables: name, invoice number, amount, due date
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en
WHATSAPP_API_VERSION=v21.0

# ---- Twilio WhatsApp (optional, alternative to Cloud API) --------------------
# Use Twilio's WhatsApp sandbox or approved sender for custom messages.
# See try_twilio.py for a standalone test script.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
TWILIO_CONTENT_SID=

# ---- Payments (Agent Payment Protocol, optional) -----------------------------
# off = free demo mode (default, safest). on = a plan is needed to send reminders:
#   $1 for the first 7 days, then $10 per month. Reviewing invoices is always free.
PAYMENTS=off
# true = Fetch.ai testnet (test FET, no real money). false = MAINNET, real FET.
FET_USE_TESTNET=true
# How many FET equal 1 USD. For testnet demos, lower it (e.g. 0.1) so you need
# little test FET. On mainnet set it from the real FET/USD price.
FET_PER_USD=4

# ---- File import (optional) -------------------------------------------------
# CollectIQ can import invoices from CSV, Excel (.xlsx/.xls), PDF, and public
# Google Sheets. Say "import csv invoices.csv" or "import google sheet <URL>"
# in the chat. Heavy dependencies (openpyxl, pandas, pdfplumber) are optional
# and only needed for the formats you use.
